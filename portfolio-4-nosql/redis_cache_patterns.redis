# ----------------------------------------------------------------------------
# PATTERN 1: EPHEMERAL SHOPPING CART (Redis Hashes with TTL Expiration)
# Business Purpose: Prevent high-frequency transient cart writes from hitting MySQL.
# ----------------------------------------------------------------------------

# 1. Initialize shopping cart hash for Customer 101
HSET cart:session:cust_101 "PROD-TECH-001" 1
HSET cart:session:cust_101 "PROD-TECH-002" 2
HSET cart:session:cust_101 "PROD-GROC-001" 5

# 2. Inspect all items in the customer cart
HGETALL cart:session:cust_101

# 3. Increment quantity of a line item atomically
HINCRBY cart:session:cust_101 "PROD-TECH-001" 1

# 4. Set 7-day TTL (604,800 seconds) so abandoned carts expire automatically
EXPIRE cart:session:cust_101 604800

# 5. Check remaining TTL
TTL cart:session:cust_101


# ----------------------------------------------------------------------------
# PATTERN 2: FLASH-SALE ATOMIC STOCK GUARD (Preventing Overselling in RAM)
# Business Purpose: Decrement inventory atomically at sub-millisecond speeds.
# ----------------------------------------------------------------------------

# 1. Warm cache with warehouse stock count from MySQL (e.g. 25 units of iPhone 15 Pro)
SET stock:cache:PROD-TECH-001 25

# 2. High-speed atomic reservation on checkout button click
DECRBY stock:cache:PROD-TECH-001 1

# 3. Check current stock level in memory
GET stock:cache:PROD-TECH-001

# 4. In case of checkout cancellation or payment decline, compensate stock back
INCRBY stock:cache:PROD-TECH-001 1


# ----------------------------------------------------------------------------
# PATTERN 3: CACHE-ASIDE PRODUCT DETAIL STRINGS (Sub-Millisecond Read Latency)
# Business Purpose: Serve viral product pages directly from RAM.
# ----------------------------------------------------------------------------

# 1. Store serialized JSON string with 1-hour TTL (3,600 seconds)
SET product:cache:PROD-TECH-001 "{\"id\":\"PROD-TECH-001\",\"name\":\"Apple iPhone 15 Pro\",\"price\":1450000,\"rating\":4.88}" EX 3600

# 2. Instant cache hit
GET product:cache:PROD-TECH-001

# 3. Invalidation pattern on price update in MySQL
DEL product:cache:PROD-TECH-001
